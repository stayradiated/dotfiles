#!/usr/bin/env zsh

# delete all old dangling images that weren't referenced in a docker build
#
# usage:
#   docker buildx build --progress=rawjson . | docker-prune-dangling

set -euo pipefail

exp=$(
  jq -r '
    [.vertexes[]?.digest // empty]
    | map(select(test("^sha256:[0-9a-f]{64}$")))
    | unique
    | if length == 0 then "^$" else "^(?:" + (join("|")) + ")$" end
  '
)

docker images --filter dangling=true --quiet --no-trunc \
| rg -vx -- "$exp" \
| xargs -r docker rmi
